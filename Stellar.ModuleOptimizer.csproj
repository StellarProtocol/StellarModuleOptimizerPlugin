<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.ModuleOptimizer</RootNamespace>
    <AssemblyName>Stellar.ModuleOptimizer</AssemblyName>
    <Version>2.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="2.0.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Stellar.ModuleOptimizer.Tests" />
  </ItemGroup>

  <!-- Launcher tile icon (raw PNG bytes passed as LauncherEntry.IconPng; the framework rasterises it).
       LogicalName matches the resource name LoadIconPng() requests. Without this the published DLL ships
       iconless and the launcher falls back to the generic puzzle-piece glyph. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/modopt-icon.png" LogicalName="Stellar.ModuleOptimizer.modopt-icon.png" />
  </ItemGroup>

  <!-- Post-build: copy DLL to local plugins/ and (if GameInstallDir is set) to game dir -->
  <PropertyGroup>
    <PluginDeployDir>$(MSBuildThisFileDirectory)plugins\moduleoptimizer\</PluginDeployDir>
    <GamePluginDir Condition="'$(GameInstallDir)' != ''">$(GameInstallDir)\stellar\plugins\moduleoptimizer\</GamePluginDir>
  </PropertyGroup>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginDeployDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GamePluginDir)"
          Condition="'$(GamePluginDir)' != ''" />
    <Warning Text="Local.props not found — skipping game deploy. Copy Local.props.example to Local.props and set GameInstallDir."
             Condition="'$(GamePluginDir)' == ''" />
  </Target>
</Project>
