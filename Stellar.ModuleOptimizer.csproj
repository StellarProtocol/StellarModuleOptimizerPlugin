<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.ModuleOptimizer</RootNamespace>
    <AssemblyName>Stellar.ModuleOptimizer</AssemblyName>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions" Version="1.1.1" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.1.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stellar.ModuleOptimizer.Tests" />
  </ItemGroup>

  <!-- Launcher tile icon (raw PNG bytes passed as LauncherEntry.IconPng; the framework rasterises it).
       LogicalName matches the resource name LoadIconPng() requests. Without this the published DLL ships
       iconless and the launcher falls back to the generic puzzle-piece glyph. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/modopt-icon.png" LogicalName="Stellar.ModuleOptimizer.modopt-icon.png" />
  </ItemGroup>
</Project>
