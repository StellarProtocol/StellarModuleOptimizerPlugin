<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.ModuleOptimizer</RootNamespace>
    <AssemblyName>Stellar.ModuleOptimizer</AssemblyName>
    <Version>2.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- i18n P2: consumes IPluginServices.Localization (framework 2.1.0). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.1.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Stellar.ModuleOptimizer.Tests" />
  </ItemGroup>

  <!-- Launcher tile icon (raw PNG bytes passed as LauncherEntry.IconPng; the framework rasterises it).
       LogicalName matches the resource name LoadIconPng() requests. Without this the published DLL ships
       iconless and the launcher falls back to the generic puzzle-piece glyph. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/modopt-icon.png" LogicalName="Stellar.ModuleOptimizer.modopt-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.ModuleOptimizer.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.ModuleOptimizer.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.ModuleOptimizer.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.ModuleOptimizer.Lang.id.json" />
  </ItemGroup>
</Project>
